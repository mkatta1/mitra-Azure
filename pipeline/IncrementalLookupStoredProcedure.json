{
	"name": "IncrementalLookupStoredProcedure",
	"properties": {
		"activities": [
			{
				"name": "Lookup_OldWaterMark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT TableName, WatermarkValue from Transactional.watermarktable_mssqltips\nwhere TableName = 'data_source_table'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "mssqltips_sp_watermark",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Lookup_NewWaterMark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT max(IngestionDate) as NewWatermarkvalue from Transactional.mssqltips_sales ",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "mssqltips_sp_watermark",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "IncrementalLookupCopy",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup_OldWaterMark",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookup_NewWaterMark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM Transactional.mssqltips_sales\nWHERE IngestionDate > '@{activity('Lookup_OldWaterMark').output.firstRow.WatermarkValue}' \nAND IngestionDate <= '@{activity('Lookup_NewWaterMark').output.firstRow.NewWatermarkvalue}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "SqlServerSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "mssqltips_sp_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "mssqltips_sp_sink",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Set_WaterMark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "IncrementalLookupCopy",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureParameters": {
						"LastModifiedDate": {
							"value": {
								"value": "@pipeline().parameters.LastModifiedtime",
								"type": "Expression"
							},
							"type": "String"
						},
						"TableName": {
							"value": {
								"value": "@pipeline().parameters.TableName",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "MicrosoftSQLServer",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"LastModifiedtime": {
				"type": "string"
			},
			"TableName": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Incremental Load"
		},
		"annotations": []
	}
}